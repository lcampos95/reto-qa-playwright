{
  "name": "reto-qa-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Suite de pruebas automatizadas UI (SauceDemo) y API (ServeRest) con Playwright + TypeScript",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "bddgen": "bddgen",
    "test:frontend": "playwright test --project=frontend-chromium --project=frontend-firefox",
    "test:frontend:chromium": "playwright test --project=frontend-chromium",
    "test:backend": "playwright test --project=backend",
    "test:ui": "npm run test:frontend",
    "test:api": "npm run test:backend",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=frontend-chromium --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "bdd:steps": "bddgen export"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.2",
    "playwright-bdd": "^9.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
