# -----------------------------------------------------------------------------
# Configuración del entorno "qa" (entornos públicos de práctica del reto).
#
# Estos valores son públicos (SauceDemo los muestra en su pantalla de login),
# por eso se versionan. En un proyecto real este archivo NO llevaría secretos:
# la contraseña vendría de una variable de entorno / secreto del pipeline.
#
# Precedencia (de mayor a menor):
#   1. Variables de entorno del sistema / CI
#   2. Archivo .env en la raíz (local, ignorado por git)
#   3. Este archivo (env/.env.<TEST_ENV>, por defecto "qa")
# -----------------------------------------------------------------------------

# UI - SauceDemo
UI_BASE_URL=https://www.saucedemo.com
SAUCE_STANDARD_USER=standard_user
SAUCE_LOCKED_USER=locked_out_user
SAUCE_PASSWORD=secret_sauce

# API - ServeRest
API_BASE_URL=https://serverest.dev
