{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@frontend/*": [
        "frontend/*"
      ],
      "@backend/*": [
        "backend/*"
      ],
      "@shared/*": [
        "shared/*"
      ]
    }
  },
  "include": [
    "frontend/**/*.ts",
    "backend/**/*.ts",
    "shared/**/*.ts",
    "playwright.config.ts"
  ]
}
