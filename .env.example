# Copia este archivo como ".env" para sobrescribir localmente cualquier valor
# de env/.env.qa sin tocar archivos versionados. Todas las variables son opcionales.

# Entorno a cargar desde la carpeta env/ (env/.env.<TEST_ENV>)
# TEST_ENV=qa

# UI_BASE_URL=https://www.saucedemo.com
# SAUCE_STANDARD_USER=standard_user
# SAUCE_LOCKED_USER=locked_out_user
# SAUCE_PASSWORD=secret_sauce

# API_BASE_URL=https://serverest.dev
